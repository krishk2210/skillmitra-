# ============================
# Skill Mitra - .gitignore
# ============================

# ── Environment Variables ──
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ── Dependencies ──
node_modules/
**/node_modules/

# ── Build Outputs ──
dist/
build/
out/
**/dist/
**/build/

# ── Vite ──
.vite/
vite.config.js.timestamp-*

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Package Manager ──
.pnpm-store/
.yarn/

# ── OS Files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── IDE & Editors ──
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── Testing ──
coverage/
*.lcov
.nyc_output/

# ── Misc ──
*.local
*.tsbuildinfo
